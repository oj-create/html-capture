{
  "manifest_version": 3,
  "name": "HTML Capture",
  "version": "1.1.1",
  "description": "Save any web page as one self-contained HTML file, with hover effects and interactions preserved. By Ojelola Ojelabi.",
  "homepage_url": "https://github.com/oj-create/html-capture",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
